# ============================================================
# Root .gitignore — Interview AI Project
# ============================================================

# ----- Node / Dependencies -----
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ----- Environment variables (NEVER commit secrets) -----
.env
.env.*
!.env.example

# ----- Build outputs -----
dist/
build/
out/
.vite/

# ----- Logs -----
logs/
*.log

# ----- OS / Editor files -----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ----- Temp / Cache -----
.cache/
.temp/
tmp/
.eslintcache
.parcel-cache/

# ----- Uploads / User files -----
Backend/uploads/
uploads/
*.pdf
*.docx

# ----- Coverage -----
coverage/
*.lcov

# ----- Optional: lock file (keep package-lock.json usually) -----
# package-lock.json
